# 服务配置：本机开发默认值
# 注意：此文件是模板，会提交到 git；不要填写真实密码，用占位符
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=mysql+aiomysql://root:<your_password>@127.0.0.1:3306/article_db_tutorial?charset=utf8mb4
DEEPSEEK_API_KEY=sk-你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# CORS 允许的来源，逗号分隔；开发用 *，生产改为前端真实域名（如 https://myapp.com）
ALLOWED_ORIGINS=*